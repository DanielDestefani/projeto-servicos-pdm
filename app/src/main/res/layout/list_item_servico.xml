<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/icone_servico"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="5dp"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@id/valor_servico"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titulo_servico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@id/icone_servico"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/icone_servico"
        app:layout_constraintTop_toTopOf="@id/icone_servico" />

    <TextView
        android:id="@+id/descricao_servico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/titulo_servico"
        app:layout_constraintTop_toBottomOf="@id/titulo_servico" />

    <TextView
        android:id="@+id/valor_servico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/descricao_servico"
        app:layout_constraintEnd_toStartOf="@id/btnAceitar"
        app:layout_constraintStart_toStartOf="@id/titulo_servico" />

    <ImageButton
        android:id="@+id/btnAceitar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_send"
        android:contentDescription="aceitar"
        app:layout_constraintEnd_toStartOf="@id/btnEditar"
        app:layout_constraintTop_toTopOf="@id/valor_servico"
        app:layout_constraintBottom_toBottomOf="@id/valor_servico" />

    <ImageButton
        android:id="@+id/btnEditar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_edit"
        android:contentDescription="editar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/valor_servico"
        app:layout_constraintBottom_toBottomOf="@id/valor_servico"
        android:layout_marginEnd="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>